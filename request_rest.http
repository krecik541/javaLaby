@id_category=36ff7412-4b0e-4e3e-b652-01c3f1118c5e

@id_recipe=6ae72174-d7f3-4f73-be12-ac7e64b1611e

### Get all categories
GET http://localhost:9080/lab4/api/categories

### Get category by id
GET http://localhost:9080/lab4/api/categories/{{id_category}}

### Create category
POST http://localhost:9080/lab4/api/categories
Content-Type: application/json

{
  "name": "123",
  "type": "LUNCH"
}

### Update category
PUT http://localhost:9080/lab4/api/categories/{{id_category}}
Content-Type: application/json

{
  "type": "BREAKFAST"
}

### Delete category
DELETE http://localhost:9080/lab4/api/categories/{{id_category}}




### Get all recipes
GET http://localhost:9080/lab4/api/recipes

### Get all recipes (by category)
GET http://localhost:9080/lab4/api/categories/{{id_category}}/recipes

### Get specific recipe form specific category
GET http://localhost:9080/lab4/api/categories/{{id_category}}/recipes/{{id_recipe}}

### Create recipe in category
POST http://localhost:9080/lab4/api/categories/{{id_category}}/recipes
Content-Type: application/json

{
  "title": "abc",
  "description": "def",
  "preparationTime": "1000"
}

### Update recipe
PUT http://localhost:9080/lab4/api/categories/{{id_category}}/recipes/{{id_recipe}}
Content-Type: application/json

{
  "title": "test",
  "description": "updated",
  "preparationTime": "5000"
}

### Delete recipe
DELETE http://localhost:9080/lab4/api/categories/{{id_category}}/recipes/{{id_recipe}}